# IDE and tooling
/.vscode
/.claude

# Root-level dependencies
node_modules/

# Python artifacts (importer service)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Credentials — never commit. The glob covers every variant (.env.local,
# .env.production, .env.bak, .env.save, …), not just the one file this stack
# reads today; `.env` alone left a stray copy stageable by `git add .` (#181).
# The committed template is the single exception. See docs/secrets.md.
.env*
!.env.example

# Database backups — contain financial data, never commit. Both rules are
# root-anchored, so deploy/backups/ needs its own: running deploy/deploy.sh from
# a checkout (#228) writes real dumps there, and the rule above would not cover
# them. deploy/imports/ and deploy/importer/parsers/ are already covered by the
# unanchored patterns further down.
/backups/*
!/backups/.gitkeep
/deploy/backups/

# Written by deploy/deploy.sh after a green health gate — the rollback target of
# one specific host, not a repository fact (#228).
/deploy/.deployed-version

# Next.js application (app/ directory)
app/node_modules
app/.next
app/out
app/.claude

# Importer — parsers are user-specific, drop folder contains user documents
imports/
importer/parsers/

# Test output
app/coverage
app/.vitest