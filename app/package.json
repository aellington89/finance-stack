{
  "name": "finance-stack",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "auth:create-user": "tsx scripts/create-user.ts",
    "check:seed-references": "tsx scripts/check-seed-references.ts",
    "check:changelog": "tsx scripts/check-changelog.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-table": "^8.21.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "//overrides": [
    "postcss/sharp: next 16.2.12 vendors postcss 8.4.31 and sharp 0.34.5, both",
    "carrying HIGH advisories with no fixed next release. Lifting them here is",
    "what makes `npm audit --omit=dev` clean (Issue #131). Drop these once next",
    "ships them itself.",
    "eslint-plugin-react-hooks: eslint-config-next floats this on a caret range;",
    "7.1.x adds react-hooks/set-state-in-effect, which flags pre-existing",
    "hydration patterns in hooks/use-mobile.ts and components/ui/date-range-picker.tsx.",
    "Pinned to the version the lockfile already used so the rule change lands in",
    "its own PR with the refactor, not bundled into unrelated work."
  ],
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.2"
  }
}
