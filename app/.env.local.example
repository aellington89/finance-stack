# Finance Stack — Next.js Application
# Copy this file to .env.local before starting development.
#
# Database connection string for Drizzle ORM (Issue #19).
# Defaults to the test database for safe local development.
# Local development (host machine): use localhost:5433
# Docker container (appnet network): use postgres:5432
#
# Local dev connects as the superuser on purpose: drizzle-kit needs DDL, and the
# integration suite calls setval() and writes the users table — neither of which
# the finance_app role may do (Issue #130). The containerized app connects as
# finance_app instead (see docker-compose.yml). To exercise least privilege
# locally, swap in:
#   postgresql://finance_app:<FINANCE_APP_DB_PASSWORD>@localhost:5433/Finances_Test
# Postgres now listens on 127.0.0.1 only, so localhost:5433 still works here.
DATABASE_URL=postgresql://postgres:changeme@localhost:5433/Finances_Test

# Secret used by Auth.js to sign/encrypt session JWTs (Issue #120).
# Required. Generate one with: openssl rand -base64 33  (or: npx auth secret)
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-33

# Credentials the Playwright E2E suite signs in as (Issue #141). Optional —
# both default to a test-only value in app/e2e/fixtures/constants.ts, so
# `npm run test:e2e` works without setting them. The account is created by the
# suite's global setup and deleted by its teardown, and neither runs unless
# DATABASE_URL names Finances_Test.
#E2E_USERNAME=e2e-test-user
#E2E_PASSWORD=e2e-only-test-password

# Port the E2E suite builds and serves the app on (Issue #141). Optional —
# defaults to 3100, chosen so it never collides with the finance-app container
# on 3001.
#E2E_PORT=3100

# Structured-log verbosity (Issue #129): debug | info | warn | error.
# Optional — defaults to "info", which is also the fallback for an unrecognized
# value. Errors are emitted at every setting. See docs/observability.md.
#LOG_LEVEL=info
