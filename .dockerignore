# Version control
.git

# Root-level dependencies
node_modules/

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Importer service — user-specific files
imports/
importer/parsers/

# IDE
.vscode/

# TypeScript build artifacts
app/tsconfig.tsbuildinfo
app/next-env.d.ts

# CI / GitHub
.github

# IDE and tooling
.vs
.claude

# Credentials — every .env variant at any depth, not just the root file this
# stack reads today (#181). This is the `repo` additional_contexts entry, out of
# which app/Dockerfile copies CHANGELOG.md (runner stage) plus init-db/roles,
# init-db/seeds, init-db/01-create-databases.sh and scripts/verify-db-roles.sh
# (migrate stage, #224) — every COPY names its source, so this is defence in
# depth; app/.dockerignore is what governs the finance-app image itself.
**/.env*
secrets/

# Documentation
*.md
# …but CHANGELOG.md must reach the image: this directory is the `repo` build
# context (docker-compose.yml additional_contexts) that the runner stage copies
# it from for the /settings/about "What's New" page. Un-ignore it.
#
# Nothing above excludes init-db/ or scripts/, which the migrate stage now copies
# from this same context (#224). Check that before adding a pattern here.
!CHANGELOG.md

# Next.js development artifacts
app/node_modules
app/.next

# Test files and output
app/tests
app/coverage
app/.vitest
app/vitest.config.ts
