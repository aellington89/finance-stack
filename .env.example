# Environment variables for the finance stack.
# Copy this file to .env and replace placeholder values before starting the stack.
#
# Every `changeme` below is a placeholder and must be replaced. This file is the
# only .env* variant that is committed; .env itself is gitignored, excluded from
# both Docker build contexts, and belongs on the deployment host with mode 600.
# See docs/secrets.md for the full inventory, production sourcing, and rotation.

# PostgreSQL superuser — used only by the maintenance jobs (migrate, init-script,
# pg-backup), never by the long-running services.
#
# THE ONE PASSWORD HERE THAT DOES NOT ROTATE IN PLACE. Every other credential in
# this file takes effect on the next `docker compose up`; this one is applied
# only when the Postgres data directory is first initialized, so editing it on an
# existing volume changes nothing and locks out every maintenance job. Alter the
# role FIRST, then update this file — migrate detects the mismatch and prints the
# procedure. See docs/database.md#rotating-a-role-password (issue #189).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# Least-privilege service roles (Issue #130). Required — the migrate service
# aborts if any of these is empty rather than creating a login role with a blank
# password. The roles themselves (finance_app, finance_importer, finance_bi)
# are created and granted automatically on every
# `docker compose up`; see docs/database.md for the grant matrix.
#
# These go into URL-form connection strings, so use URL-safe characters or
# percent-encode them (the same constraint POSTGRES_PASSWORD already has:
# a literal @ : / ? # in a password will break the URL).
FINANCE_APP_DB_PASSWORD=changeme
FINANCE_IMPORTER_DB_PASSWORD=changeme
# Metabase's connection to the Finances database: read-only on the core tables
# and views, with no access to users or audit_log (#249). Entered by hand in the
# Metabase admin UI rather than consumed by docker-compose.yml — Metabase stores
# its analytics connections in its own metadata database, not in env vars.
FINANCE_BI_DB_PASSWORD=changeme

# Metabase internal metadata database. MB_DB_PASS rotates in place like the
# FINANCE_* values above — migrate re-issues ALTER ROLE … PASSWORD on every run
# (#189) — and since #225 migrate also creates the role and the database.
#
# This is the one credential here whose emptiness is meaningful: leave it blank
# and migrate skips Metabase provisioning entirely, which is how a stack that
# never wants Metabase avoids carrying the value. Once that database exists,
# though, it is required — migrate refuses to run rather than quietly set a
# blank password on a role that is already there.
MB_DB_DBNAME=metabase
MB_DB_USER=metabase_user
MB_DB_PASS=changeme

# Timezone
TZ=America/Chicago

# Init-script target database (set to "Finances_Test" to run against the test DB)
INIT_SCRIPT_DB=Finances

# The application database. Since #225 the migrate service creates whatever you
# name here, rather than creating a hardcoded "Finances" and then migrating this
# one — so changing it on a fresh volume now actually works.
FINANCE_APP_DB=Finances

# Secret used by Auth.js to sign/encrypt session JWTs (Issue #120).
# Required by finance-app. Generate one with: openssl rand -base64 33
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-33

# Structured-log verbosity for finance-app (Issue #129): debug | info | warn |
# error. Optional — docker-compose.yml defaults it to "info", which is also the
# fallback for an unrecognized value. Errors are emitted at every setting.
# Read them with: docker compose logs finance-app | jq -c 'select(.level=="error")'
# See docs/observability.md.
LOG_LEVEL=info

# Error tracking (Issue #232) — where finance-app ships unhandled errors in
# addition to the log above. Optional, and commented out because unset is a
# supported configuration: the structured logger stays the only sink and nothing
# else about the stack changes.
#
# Any backend speaking the Sentry ingest protocol works. `docker compose
# --profile errors up -d` starts a self-hosted GlitchTip in this stack, which
# keeps the data on this host — the posture the README asks for. Sentry SaaS also
# works and is more egress. Create a project in whichever you pick and paste its
# DSN here, using the container name (`glitchtip`) rather than localhost: this is
# resolved from inside the finance-app container.
#
# What is sent is the same redacted record that reaches the log: no bound query
# parameters, no pg `detail`. What is NOT sent is browser-side errors — the DSN
# is deliberately not NEXT_PUBLIC_, so it never enters the client bundle.
# See docs/observability.md.
# ERROR_DSN=http://yourpublickey@glitchtip:8000/1

# The self-hosted backend for the DSN above, started with
# `docker compose --profile errors up -d`. Off by default, like the bi and edge
# profiles. It runs as ONE container — web, worker and its own Django migrations
# — and keeps its data in this stack's Postgres, in a database owned by a role
# that can reach nothing else in the cluster. No Redis is added: the task queue
# and cache go on Postgres too.
#
# GLITCHTIP_DB_PASSWORD is the credential, and its emptiness is meaningful in
# exactly the way MB_DB_PASS's is: leave it blank and migrate skips provisioning
# the role and the database entirely. Once that database exists it is required,
# and migrate syncs the password from here on every run, so it rotates in place.
#
# SECRET_KEY signs GlitchTip's own sessions. Generate one with:
#   openssl rand -base64 33
# GLITCHTIP_DB_PASSWORD=changeme
# GLITCHTIP_SECRET_KEY=changeme-generate-with-openssl-rand-base64-33

# The absolute URL GlitchTip builds links with. It binds 127.0.0.1:8000, so the
# default is right unless you reach it through a tunnel or a proxy.
# GLITCHTIP_DOMAIN=http://localhost:8000

# ALERTING IS NOT CONFIGURED BY DEFAULT (#340), and this is the variable that
# changes that. GlitchTip notifies by email only — there is no webhook option — and the
# default `consolemail://` writes notification mail to the glitchtip container's
# log instead of sending it. That gives durable, queryable, backed-up error
# history but no alert that leaves the host. Point this at a real relay to get
# one:
#   GLITCHTIP_EMAIL_URL=smtp://user:password@smtp.example.com:587
# GLITCHTIP_EMAIL_URL=consolemail://
# GLITCHTIP_FROM_EMAIL=glitchtip@localhost

# Self-signup, closed by default: on a LAN, open registration means anyone who
# can reach the port can create an account. Create the first user with
#   docker compose exec glitchtip ./manage.py createsuperuser
# and leave this alone.
# GLITCHTIP_OPEN_REGISTRATION=False

# Django's Host-header allowlist for GlitchTip. The default covers loopback and
# the container name, which is all the shipped binding needs; extend it if you
# front this with a proxy or reach it under another name.
# GLITCHTIP_ALLOWED_HOSTS=localhost,127.0.0.1,glitchtip

# The role and database names. Defaults are fine; both are created by migrate.
# GLITCHTIP_DB_USER=glitchtip
# GLITCHTIP_DB_DBNAME=glitchtip

# TLS / reverse proxy (Issue #182) — only read by the caddy service, which is
# not started unless you run `docker compose --profile edge up -d`. Leave this
# alone for localhost or trusted-network use; nothing else consumes it.
#
# Required by that profile, and must be a DNS name that resolves to this host,
# because Caddy proves control of it to get a certificate. Unset, only the caddy
# container fails to start; the rest of the stack is unaffected.
# See docs/deployment.md.
# PUBLIC_HOSTNAME=finance.example.com

# Backups (Issue #122) — the pg-backup service dumps these to ./backups/.
# BACKUP_DBS is a comma-separated list; keep it in sync with FINANCE_APP_DB
# and MB_DB_DBNAME above if you customize those names.
# These are optional for the .env file. All three have defaults in docker-compose.yml, but you can override them here if you want to change the retention period or interval.
BACKUP_DBS=Finances,metabase,glitchtip
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
